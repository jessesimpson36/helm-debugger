# Single source of truth for the pinned toolchain.
#
# This file is both valid `make` (the Makefile includes it) and valid shell
# (CI sources it), so the CLI build, the Docker image, and release metadata all
# agree on one set of versions. Override on the make command line, e.g.
#   make docker-build GO_VERSION=1.26.7
GO_VERSION=1.26.7
HELM_VERSION=v4.3.0
DELVE_VERSION=v1.27.2
